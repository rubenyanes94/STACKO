# Copia este archivo como .env y pon tu ID de Formspree (https://formspree.io → New form → ID tras /f/)
# Sin él, el formulario de contacto abre el correo del visitante con el mensaje ya redactado.
VITE_FORMSPREE_ID=

# Dominio de producción, sin barra final. En producción ya viene de .env.production (https://www.stackolabs.com).
VITE_SITE_URL=
